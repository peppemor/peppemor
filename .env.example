# =====================================================
# CONFIGURATION TEMPLATE - Copy to .env and fill in
# =====================================================

# DATABASE CONFIGURATION
# Cambiat le credenziali con quelle del tuo PostgreSQL locale
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/peppemor"

# JWT AUTHENTICATION
# Genera una stringa casuale complessa per la produzione
JWT_SECRET="generate_a_random_secure_string_here_for_production"

# SERVER CONFIGURATION
SERVER_PORT=3001

# CONTACT EMAIL
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# FRONTEND API CONFIGURATION
# URL del server API per il frontend React
VITE_API_URL="http://localhost:3001/api"

# ENVIRONMENT
NODE_ENV="development"

# =====================================================
# DEPRECATED - Supabase (leave commented or remove)
# =====================================================
# VITE_SUPABASE_URL="<your_supabase_url>"
# VITE_SUPABASE_ANON_KEY="<your_supabase_key>"
# RESEND_API_KEY="<your_resend_key>"
